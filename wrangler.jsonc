// Cloudflare Worker configuration for TypeCraft (see SETUP.md).
// index.html (the app) is only sent to signed-in browsers. /api/*, /admin, /console and the
// pages run the Worker code in src/.
{
  "$schema": "node_modules/wrangler/config-schema.json",
  "name": "typecraft",
  "main": "src/index.js",
  "compatibility_date": "2026-11-01",
  "assets": {
    "directory": ".",
    "binding": "ASSETS",
    // Pages, /api and every .html file reach src/index.js first (sign-in checks, redirects, headers).
    // The folders after "!" hold only public files (styles, scripts, icons): Cloudflare serves those
    // directly, which is free and does not count towards the Workers request limit.
    // Anything not listed here stays behind the Worker, so a new file is protected until it is added.
    "run_worker_first": ["/*", "!/css/*", "!/js/*", "!/shared/*", "!/icons/*", "!/site/*", "!/manifest.webmanifest"],
    // files are served at their exact paths (the Worker asks for /index.html and /login.html)
    "html_handling": "none"
  },

  // ACCOUNTS DATABASE (SETUP.md, step 2): the D1 database "typecraft".
  // Its tables are created by migrations/0001_accounts.sql (SETUP.md, step 1).
  "d1_databases": [
    {
      "binding": "DB",
      "database_name": "typecraft",
      "database_id": "9df6b720-1fbc-4022-b547-fdf86bd59a28",
      "migrations_dir": "migrations"
    }
  ],

  // Email settings (RESEND_API_KEY, EMAIL_FROM, optional APP_URL) and OWNER_EMAILS
  // (comma-separated emails allowed to open /admin) are set as secrets in the
  // Cloudflare dashboard, never in this file. keep_vars stops a
  // deploy from removing anything set there.
  "keep_vars": true,

  // nightly (02:47 India time): clean-up of expired sessions and links, then the
  // rebuild of every learner's totals from their saved events (src/pipeline.js)
  "triggers": { "crons": ["17 21 * * *", "*/10 * * * *"] },
  // not secret: the public address and the email sender (secrets are set in Cloudflare, see docs/SAAS-CONTRACTS.md §10)
  "vars": {
    "SITE_URL": "https://typecrafttyping.in",
    "EMAIL_FROM": "TypeCraft <hello@typecrafttyping.com>",
    "EMAIL_REPLY_TO": "hello@typecrafttyping.com"
  },
  "observability": { "enabled": true }
}
